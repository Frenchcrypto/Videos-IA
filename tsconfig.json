{
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "module": "ES2020",
    "target": "ES2022",
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src"]
}
